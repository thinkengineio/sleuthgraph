# --- Postgres ---
POSTGRES_USER=sleuthgraph
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=sleuthgraph

# --- Redis ---
# AUTH is required end-to-end. Redis boots with --requirepass and the
# service is NOT published to the host — connections go through the
# internal docker network. Debugging uses
# `docker compose exec redis redis-cli -a "$REDIS_PASSWORD"`.
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=changeme_local_only_redis

# --- MinIO (evidence object storage) ---
MINIO_ROOT_USER=sleuthgraph
MINIO_ROOT_PASSWORD=changeme_local_only
MINIO_BUCKET=evidence

# --- API ---
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://sleuthgraph:changeme_local_only@db:5432/sleuthgraph
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
ARQ_REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/0
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=sleuthgraph
S3_SECRET_KEY=changeme_local_only
S3_BUCKET=evidence
SECRET_KEY=generate-me-with-openssl-rand-hex-32
CORS_ORIGINS=http://localhost:3000

# --- Web ---
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- AI (optional; set for Phase 10) ---
ANTHROPIC_API_KEY=

# --- Auth (Phase 2) ---
# Cookie behavior. SECRET_KEY is already defined above and reused for JWT signing.
AUTH_COOKIE_NAME=sleuthgraph_session
AUTH_COOKIE_SECURE=false          # set true behind HTTPS / prod
AUTH_SESSION_LIFETIME_SECONDS=604800

# Public self-signup (default: false; admin creates users — Grafana-style).
AUTH_ALLOW_SIGNUP=false

# Bootstrap admin on first startup (skipped if unset; idempotent on subsequent starts).
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=

# --- OIDC (optional) ---
# Full login flow wired in Phase 2.5; Phase 2 only exposes /auth/oidc-status.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
